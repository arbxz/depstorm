{
  "name": "depstorm",
  "version": "1.0.0",
  "description": "Periodically audit, fix, and verify npm/pnpm/yarn projects",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "depstorm": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "audit",
    "npm",
    "pnpm",
    "security",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "cosmiconfig": "^10.0.1",
    "execa": "^10.0.1",
    "node-cron": "^4.6.0",
    "simple-git": "^4.0.2"
  },
  "optionalDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-sonarjs": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "simple-git@<3.36.0": ">=3.36.0",
      "uuid@<11.1.1": ">=11.1.1",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1"
    }
  }
}
