{
  "name": "depstorm",
  "version": "1.0.0",
  "description": "Periodically audit, fix, and verify npm/pnpm/yarn projects",
  "type": "module",
  "bin": {
    "depstorm": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "audit",
    "npm",
    "pnpm",
    "security",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "consola": "^3.2.3",
    "cosmiconfig": "^9.0.0",
    "execa": "^9.5.2",
    "node-cron": "^3.0.3",
    "simple-git": "^3.27.0"
  },
  "optionalDependencies": {
    "eslint": "^10.1.0",
    "eslint-plugin-sonarjs": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "simple-git@<3.36.0": ">=3.36.0"
    }
  }
}
