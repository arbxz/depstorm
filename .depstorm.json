{
  "roots": ["."],
  "severityThreshold": "high",
  "autoFix": true,
  "verifyBuild": true,
  "revertOnFailure": true,
  "gitBranch": true,
  "gitCommit": true,
  "gitPush": false,
  "gitMerge": false,
  "autoStash": false,
  "allowInstallScripts": false,
  "sonarCheck": true,
  "dryRun": false,
  "sourceBranch": "current",
  "scanDepth": 3,
  "excludeDirs": ["node_modules", ".git", "dist", "build", ".next", ".nuxt"],
  "reportPath": "./audit-reports/report"
}
